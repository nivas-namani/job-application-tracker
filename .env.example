# Copy this file to .env for local development. Do not commit real credentials.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://trackify:trackify@localhost:5432/trackify?schema=public"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional S3-compatible storage (Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=trackify-resumes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
