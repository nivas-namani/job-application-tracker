{
  "name": "trackify",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c magenta,cyan \"npm run dev -w @trackify/client\" \"npm run dev -w @trackify/server\"",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "prisma:generate": "npm run prisma:generate -w @trackify/server",
    "prisma:migrate": "npm run prisma:migrate -w @trackify/server",
    "prisma:seed": "npm run prisma:seed -w @trackify/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20.14.0",
    "npm": ">=10"
  }
}
